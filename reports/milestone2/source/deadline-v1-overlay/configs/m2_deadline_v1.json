{
  "schema_version": 1,
  "run_id": "m2-deadline-v1",
  "claim": "One seed (1); matched ordinary/adversarial FP32 pair trained for the locked epoch count; INT8 by post-training quantization only; feature-space attacks; approximate (BPDA) INT8 gradients; QAT feasibility only, no QAT performance claim.",
  "seed": 1,
  "split_dir": "reports/milestone2b/split_v2",
  "siblings": {
    "training": "configs/m2/training.json",
