    "data": "configs/m2b/data_v2.json"
  },
  "training": {
    "epoch_candidates": [25, 10, 5],
    "threads": 2,
    "keep_last": 2,
    "batch_size_expected": 512,
    "checkpoint_rule": "final epoch; no validation-based selection"
  },
  "budget": {
    "hard_cap_hours": 9.0,
    "reserve_hours": 3.0,
    "safety_multiplier": 1.25,
